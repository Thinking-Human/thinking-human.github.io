---
// Landing page: wordmark, a pill for the newest post, then a short text-led
// statement in sections. Edit the copy in `intro` and `sections` below.
import Base from '../layouts/Base.astro';
import { getPosts, withBase } from '../lib/posts';
import { SITE } from '../site.config';

const [latest] = await getPosts();

const intro = [
  'Thinking-Human is a research group working on AI agents that perceive, decide, and act in the physical world.',
  'Language models can now plan, write code, and use tools. Robots still mostly run policies trained for one embodiment and one set of tasks. We study what it takes to close that gap: how an agent should be told its task, what it should see and send to the world, how it remembers, how it keeps up with time, and how it improves across episodes.',
];

const sections = [
  {
    title: 'One loop, many builds',
    points: [
      ['Start from the loop.', 'Every robot policy, end-to-end or agentic, can be read as the same agent–environment loop. Comparing systems part by part is clearer than comparing them by architecture.'],
      ['Combine, do not choose.', 'Vision-language-action models are good at moving; language-model agents are good at deciding what to do next. We are interested in systems that use each where it is strongest.'],
    ],
  },
  {
    title: 'Writing things down',
    points: [
      ['Open notes.', 'We publish long-form technical posts with interactive figures, and the code behind them, so others can check, reuse, and build on the work.'],
    ],
  },
  {
    title: 'Get in touch',
    points: [
      ['We like to talk.', 'If you work on robot learning, agents, or the space between them, we would be glad to hear from you.'],
    ],
  },
];
---

<Base title={SITE.name} bare>
  <section class="landing">
    <h1 class="mark" aria-label={SITE.name}>
      <span>Thinking</span>
      <span>Human</span>
    </h1>

    {
      latest && (
        <a class="pill" href={withBase(`posts/${latest.id}/`)}>
          <span class="pill-tag">New</span>
          {latest.data.title}
        </a>
      )
    }

    <div class="statement">
      {intro.map((p) => <p>{p}</p>)}

      {
        sections.map((s) => (
          <section>
            <h2>{s.title}</h2>
            {s.points.map(([lead, text]) => (
              <p>
                <em>{lead}</em> {text}
              </p>
            ))}
          </section>
        ))
      }

      <p class="links">
        <a href={withBase('blog/')}>Read the blog →</a>
        <a href="https://github.com/Thinking-Human">GitHub</a>
        <a href={withBase('rss.xml')}>RSS</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .landing {
    padding: 3.5rem 0 2rem;
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font: 400 clamp(52px, 9vw, 84px) / 1 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mark span {
    background: linear-gradient(90deg, #4a4a4a, #b9b9b9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pill {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    margin: 36px auto 0;
    font: 13px/1.4 var(--sans);
    color: var(--ink);
    text-decoration: none;
  }

  .pill:hover {
    text-decoration: underline;
  }

  .pill-tag {
    padding: 3px 8px;
    border-radius: 999px;
    background: #efefec;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .statement {
    max-width: 600px;
    margin: 48px auto 0;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.75;
    color: var(--body-ink);
  }

  .statement p {
    margin: 0 0 1.4em;
  }

  .statement h2 {
    margin: 2.6em 0 0.8em;
    font: 400 22px/1.3 var(--sans);
    letter-spacing: -0.2px;
    color: var(--ink);
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 3em !important;
    font-family: var(--sans);
    font-size: 14px;
  }
</style>
