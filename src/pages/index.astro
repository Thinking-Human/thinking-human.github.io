---
// Landing page: wordmark, a pill for the newest post, then a short text-led
// statement in sections. Edit the copy in `intro` and `sections` below.
import Base from '../layouts/Base.astro';
import { getPosts, withBase } from '../lib/posts';
import { SITE } from '../site.config';

const [latest] = await getPosts();

const intro = [
  'Thinking-Human is a small group of researchers sharing what we explore in AI.',
  'There is more writing about AI than ever, and less of it is worth reading: generated, padded, written to be shared rather than understood. We want the opposite. Say one thing clearly, show it with a figure, and stop.',
];

const sections = [
  {
    title: 'Less, but better',
    points: [
      ['One question per post.', 'Each post starts from something we actually wanted to know, and ends when it is answered.'],
      ['Figures before paragraphs.', 'If a table, a diagram, or an animation says it faster, we use that instead of prose.'],
    ],
  },
  {
    title: 'Made by people',
    points: [
      ['Tools, not authors.', 'We use AI tools freely. The questions, the claims, and the mistakes are ours, and we stand behind every one.'],
      ['Show the work.', 'Interactive figures, sources, and code, so readers can check instead of trust.'],
    ],
  },
  {
    title: 'Any topic',
    points: [
      ['Wherever the question leads.', 'Our first post is on agents for robots. The next may be on something else entirely.'],
    ],
  },
  {
    title: 'Get in touch',
    points: [
      ['Tell us.', 'If you want to write this way too, or think we got something wrong, we would like to hear it.'],
    ],
  },
];
---

<Base title={SITE.name} bare>
  <section class="landing">
    <h1 class="mark" aria-label={SITE.name}>
      <span>Thinking</span>
      <span>Human</span>
    </h1>

    {
      latest && (
        <a class="pill" href={withBase(`posts/${latest.id}/`)}>
          <span class="pill-tag">New</span>
          {latest.data.title}
        </a>
      )
    }

    <div class="statement">
      {intro.map((p) => <p>{p}</p>)}

      {
        sections.map((s) => (
          <section>
            <h2>{s.title}</h2>
            {s.points.map(([lead, text]) => (
              <p>
                <em>{lead}</em> {text}
              </p>
            ))}
          </section>
        ))
      }

      <p class="links">
        <a href={withBase('blog/')}>Read the blog →</a>
        <a href="https://github.com/Thinking-Human">GitHub</a>
        <a href={withBase('rss.xml')}>RSS</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .landing {
    padding: 3.5rem 0 2rem;
  }

  .mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    font: 400 clamp(52px, 9vw, 84px) / 1 var(--sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mark span {
    background: linear-gradient(90deg, #4a4a4a, #b9b9b9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pill {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 10px;
    margin: 36px auto 0;
    font: 13px/1.4 var(--sans);
    color: var(--ink);
    text-decoration: none;
  }

  .pill:hover {
    text-decoration: underline;
  }

  .pill-tag {
    padding: 3px 8px;
    border-radius: 999px;
    background: #efefec;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .statement {
    max-width: 600px;
    margin: 48px auto 0;
    font-family: var(--serif);
    font-size: 16px;
    line-height: 1.75;
    color: var(--body-ink);
  }

  .statement p {
    margin: 0 0 1.4em;
  }

  .statement h2 {
    margin: 2.6em 0 0.8em;
    font: 400 22px/1.3 var(--sans);
    letter-spacing: -0.2px;
    color: var(--ink);
  }

  .links {
    display: flex;
    gap: 20px;
    margin-top: 3em !important;
    font-family: var(--sans);
    font-size: 14px;
  }
</style>
